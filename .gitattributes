* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Fuzz inputs are exact bytes (CR, CRLF and NUL cases included): never
# convert their line endings.
fuzz/corpus/** -text

# Vendored Fathom: exact bytes as pinned (SHA-256s in docs/ORIGINALITY.md); never convert.
third_party/fathom/** -text

# GitHub's language bar shows the engine: tooling folders are not counted.
tools/** linguist-detectable=false
bench/** linguist-detectable=false
