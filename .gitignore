build/
out/
*.profraw
*.profdata
*.gcda
/.vs/
/.vscode/
.venv/
.cache/
fuzz/artifacts/
fuzz/corpus/*/*
!fuzz/corpus/*/seed-*
__pycache__/
# Session notes and local backups stay out of the public history (CLAUDE.md).
/HANDOFF.md
/MORNING.md
/REVIEW-*.md
*.bundle
# Claude Code agent worktrees (nested git checkouts; never part of the tree).
/.claude/worktrees/
# Personal Claude Code settings (permissions, local paths); the shared ones
# are .claude/settings.json.
/.claude/settings.local.json
# fastchess autosaves its configuration into the working directory.
/config.json
# Large data that never belongs in the repository: Syzygy tablebases, NNUE
# networks, training data, game archives and opening suites (test suites are
# downloaded into .cache/ with pinned SHA-256s; see CMakeLists.txt).
*.rtbw
*.rtbz
*.nnue
*.binpack
*.pgn
*.pgn.gz
*.epd
*.zst
*.7z
