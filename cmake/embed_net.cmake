# SPDX-License-Identifier: GPL-3.0-or-later
#
# Writes OUT, a C++ source holding the bytes of the network file NET, so the
# network is compiled into Fork (DESIGN.md §5.3, deliverable 5: TCEC builds
# from a clean clone, offline). The engine validates the bytes at startup
# (src/eval/nnue/net_file.cpp).
#
# Up to 16 MB the bytes are written out as an array. A larger network (S512cl's
# is about 54 MB; DESIGN.md §5.4) would make that array hundreds of megabytes
# of source, too large to compile, so the source has the assembler include the
# file itself instead (.incbin, which every GNU-compatible assembler of
# Fork's toolchains has: TCEC's gcc and clang on Linux, MinGW on Windows),
# with the size written in from here.
#
#   cmake -DNET=path/to/net.fnet -DOUT=embedded_net_data.cpp [-DSYMBOL=name] -P embed_net.cmake
#
# SYMBOL names the C++ symbols (<SYMBOL>_bytes, <SYMBOL>_size, <SYMBOL>_data,
# and fork_<SYMBOL>_blob for .incbin); the default, embedded_net, is the
# engine's network. A refiner build (ideas.md 59) embeds its refiner as embedded_refiner.
if(NOT SYMBOL)
  set(SYMBOL embedded_net)
endif()

get_filename_component(name ${NET} NAME)
file(SIZE ${NET} bytes)
if(bytes GREATER 16777216)
  get_filename_component(path ${NET} ABSOLUTE)
  file(WRITE ${OUT}.tmp
    "// Generated by cmake/embed_net.cmake from ${name}; do not edit.\n"
    "// The network's ${bytes} bytes, included by the assembler (.incbin).\n"
    "#include <cstddef>\n\n"
    "__asm__(\n"
    "#if defined(_WIN32)\n"
    "    \".section .rdata,\\\"dr\\\"\\n\"\n"
    "#else\n"
    "    \".section .rodata\\n\"\n"
    "#endif\n"
    "    \".balign 64\\n\"\n"
    "    \".globl fork_${SYMBOL}_blob\\n\"\n"
    "    \"fork_${SYMBOL}_blob:\\n\"\n"
    "    \".incbin \\\"${path}\\\"\\n\"\n"
    "    \".text\\n\");\n\n"
    "extern \"C\" const unsigned char fork_${SYMBOL}_blob[];\n\n"
    "namespace forkeng {\n"
    "extern const unsigned char* const ${SYMBOL}_bytes;\n"
    "extern const std::size_t ${SYMBOL}_size;\n"
    "const unsigned char* const ${SYMBOL}_bytes = fork_${SYMBOL}_blob;\n"
    "const std::size_t ${SYMBOL}_size = ${bytes};\n"
    "}  // namespace forkeng\n")
else()
  file(READ ${NET} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  file(WRITE ${OUT}.tmp
    "// Generated by cmake/embed_net.cmake from ${name}; do not edit.\n"
    "#include <cstddef>\n\n"
    "namespace forkeng {\n"
    "extern const unsigned char* const ${SYMBOL}_bytes;\n"
    "extern const std::size_t ${SYMBOL}_size;\n"
    "alignas(64) const unsigned char ${SYMBOL}_data[] = {${body}};\n"
    "const unsigned char* const ${SYMBOL}_bytes = ${SYMBOL}_data;\n"
    "const std::size_t ${SYMBOL}_size = ${bytes};\n"
    "}  // namespace forkeng\n")
endif()
file(RENAME ${OUT}.tmp ${OUT})
