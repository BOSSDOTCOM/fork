# Writes build_id.hpp for fork_micro: the build's variant label and the git
# commit it was built from ("-dirty" if tracked files had uncommitted changes).
# Runs at every build; the header is rewritten only when its content changes,
# so an unchanged tree does not recompile anything.
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -DVARIANT=... -P build_id.cmake
find_package(Git QUIET)
set(commit "unknown")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
                  WORKING_DIRECTORY ${SOURCE_DIR}
                  OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE head_failed ERROR_QUIET)
  if(NOT head_failed)
    set(commit ${head})
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
                    WORKING_DIRECTORY ${SOURCE_DIR}
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
      string(APPEND commit "-dirty")
    endif()
  endif()
endif()

set(content "// Generated by cmake/build_id.cmake. Do not edit.\n"
            "#pragma once\n"
            "#define FORK_BUILD_VARIANT \"${VARIANT}\"\n"
            "#define FORK_BUILD_COMMIT \"${commit}\"\n")
string(CONCAT content ${content})
set(old "")
if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} old)
endif()
if(NOT old STREQUAL content)
  file(WRITE ${OUTPUT} "${content}")
endif()
